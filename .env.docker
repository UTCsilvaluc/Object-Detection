#exemple .env.docker file
# =========================
# Database
# =========================
DB_HOST=db
DB_PORT=5432
DB_NAME=object_detection
DB_USER=object_admin
DB_PASSWORD=to_change

# =========================
# Paths in container
# =========================
MEDIA_ROOT=/data/media
TEMP_ROOT=/data/media/temp
MEDIA_URL=/media

# =========================
# App runtime
# =========================
FLASK_ENV=production
FLASK_DEBUG=0
SERVE_MEDIA_WITH_FLASK=0

# =========================
# Performance (optional)
# =========================
TORCH_NUM_THREADS=4
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
